    SUM(fact_acs_wi_county[estimate]),
    FILTER(
        dim_dem_category,
        dim_dem_category[gender] = "Female" &&
        dim_dem_category[category] = 
            SELECTEDVALUE('Demo Category Selector'[category], "Age")
    )
)





